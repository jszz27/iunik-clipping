# Copy to .env and fill in. Never commit .env.
# One or more RapidAPI keys, comma-separated. Extra keys are rotated on 429.
RAPIDAPI_KEYS=your_key_here,optional_second_key

# Brand handle to monitor for tags and mentions.
BRAND_HANDLE=iunik_official

# Abort a run rather than silently draining the plan.
MAX_CALLS_PER_RUN=500

# Google Sheets export (optional until step 8).
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
